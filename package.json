{
  "name": "pi-tps-live",
  "version": "1.0.2",
  "description": "Live tokens-per-second in pi's footer first line: sliding-window tok/s while streaming, exact last-turn average at rest.",
  "keywords": [
    "pi-package",
    "pi",
    "tps",
    "tokens-per-second",
    "throughput",
    "footer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamcjm/pi-tps-live.git"
  },
  "homepage": "https://github.com/adamcjm/pi-tps-live",
  "bugs": {
    "url": "https://github.com/adamcjm/pi-tps-live/issues"
  },
  "files": [
    "extensions"
  ],
  "scripts": {
    "test": "bun run test/run-tests.ts && bun run test/e2e.ts",
    "test:unit": "bun run test/run-tests.ts",
    "test:e2e": "bun run test/e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-tps-live"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
